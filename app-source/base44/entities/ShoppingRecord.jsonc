{
  "name": "ShoppingRecord",
  "type": "object",
  "properties": {
    "shop_name": {
      "type": "string",
      "description": "Name of the shop or market"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Shopping date in YYYY-MM-DD"
    },
    "items": {
      "type": "array",
      "description": "Items bought in this shopping",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "estimated_price": {
            "type": "number",
            "description": "Original market estimate per unit before the actual shop price was entered"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Grand total of this shopping"
    },
    "item_count": {
      "type": "number",
      "description": "Number of items in this shopping"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "bill"
      ],
      "enumColors": [
        "green",
        "blue"
      ],
      "description": "How the record was added"
    },
    "bill_file_uri": {
      "type": "string",
      "description": "Private storage uri of the uploaded bill"
    }
  },
  "required": [
    "date",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}