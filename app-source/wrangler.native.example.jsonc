{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-hisab-native",
  "main": "src/server.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "vars": {
    "APP_BASE_URL": "https://shopping-hisab-native.YOUR-SUBDOMAIN.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopping-hisab-native",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID",
      "migrations_dir": "migrations-native"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "shopping-hisab-private"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
